<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klab.Toolkit.Common\Klab.Toolkit.Common.csproj" />
    <ProjectReference Include="..\Klab.Toolkit.DI\Klab.Toolkit.DI.csproj" />
    <ProjectReference Include="..\Klab.Toolkit.ExtensionMethods\Klab.Toolkit.ExtensionMethods.csproj" />
    <ProjectReference Include="..\Klab.Toolkit.Messaging\Klab.Toolkit.Messaging.csproj" />
    <ProjectReference Include="..\Klab.Toolkit.Messaging.Abstractions\Klab.Toolkit.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\Klab.Toolkit.Results\Klab.Toolkit.Results.csproj" />
    <ProjectReference Include="..\Klab.Toolkit.ValueObjects\Klab.Toolkit.ValueObjects.csproj" />
  </ItemGroup>
</Project>
